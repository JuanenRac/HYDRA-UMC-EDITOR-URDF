/* =============================================================================
HYDRA-UMC EDITOR-URDF - industrial_dark.qss
Copyright (C) 2026 JuanenRac (Electro Hobby 3D) <electrohobby3d@gmail.com>
GPL-3.0 - see LICENSE

"Futuristic industrial" theme - dark slate base, cyan accent, matching the
same visual language HYDRA-UMC-STUDIO's own web UI already established
(same family of dark-panel/cyan-highlight industrial dashboards) rather
than inventing an unrelated look for this sibling project.

A real, deliberate sync from HYDRA-UMC-SUITE's own copy of this file
(see ui/theme.py's own header comment) - real user feedback found this
copy had quietly drifted to an older, flatter palette (no command-deck
gradient/border-glow rules at all), the opposite of what "reuses ...
verbatim" was supposed to mean. One real addition on top of SUITE's own
current file: `QToolButton#commandDeckNav`, styled identically to
`#commandDeckAbout` right below it - SUITE dropped that selector when
its own command deck's flat nav buttons moved into a new left sidebar,
but this app's own command deck still uses real `commandDeckNav`
buttons for Source/DOF Validation/3D Viewport/Properties/Export URDF
(see ui/main_window.py's own `_add_deck_navigation`) - it has no
sidebar to move them into instead.
============================================================================= */

* {
    font-family: "Bahnschrift", "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
    color: #edf7ff;
}

QMainWindow, QDialog {
    background-color: #07111e;
}

QWidget#centralWorkspace {
    background-color: #0b0e13;
}

QMenuBar {
    background-color: #091827;
    border-bottom: 1px solid #1d4056;
    padding: 3px 8px;
}
QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
}
QMenuBar::item:selected {
    background-color: #17334d;
    border-radius: 5px;
}
QMenu {
    background-color: #10243a;
    border: 1px solid #315773;
}
QMenu::item {
    padding: 6px 22px;
}
QMenu::item:selected {
    background-color: #397dff;
    color: #f5fbff;
}

QToolBar {
    background-color: #091827;
    border-bottom: 1px solid #1d4056;
    spacing: 6px;
    padding: 4px;
}

/* Persistent control-deck chrome: a functional quick route to Suite's
   dockable panels, styled in the same deep-navy/cyan language as Updater. */
QToolBar#commandDeck {
    background-color: #0a1a2b;
    border-top: 1px solid #17354a;
    border-bottom: 1px solid #294965;
    padding: 7px 10px;
    spacing: 7px;
    min-height: 48px;
}
QToolBar#commandDeck::separator {
    background: #294965;
    width: 1px;
    margin: 5px 8px;
}
QWidget#suiteBrand {
    background: #0e3045;
    border: 1px solid #2d7695;
    border-radius: 12px;
    padding: 7px;
}
QLabel#commandDeckTitle {
    color: #edf7ff;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 0 7px 0 2px;
}
QToolButton#commandDeckNav, QToolButton#commandDeckAbout {
    background: #10243a;
    border: 1px solid #294965;
    border-radius: 10px;
    color: #c8e5f5;
    font-weight: 600;
    padding: 8px 12px;
}
QToolButton#commandDeckNav:hover, QToolButton#commandDeckAbout:hover {
    background: #1a4967;
    border-color: #38d4e6;
    color: #ffffff;
}
QToolButton#commandDeckNav:pressed, QToolButton#commandDeckAbout:pressed {
    background: #13364f;
}

/* Real left navigation panel - see ui/nav_sidebar.py's own header for
   why this replaced the command deck's own flat nav buttons above (real
   user feedback: SUITE didn't match STUDIO's own left-panel menu/submenu
   scheme). Same deep-navy/cyan language as the rest of this stylesheet. */
QDockWidget#dock_nav_sidebar {
    border: none;
    border-right: 1px solid #17354a;
}
QWidget#navSidebar {
    background-color: #0a1a2b;
}
QPushButton#navSidebarItem, QPushButton#navSidebarCategory, QPushButton#navSidebarBack {
    background: transparent;
    border: none;
    border-radius: 9px;
    color: #c8e5f5;
    font-weight: 600;
    font-size: 12px;
    text-align: left;
    padding: 9px 12px;
}
QPushButton#navSidebarItem:hover, QPushButton#navSidebarCategory:hover, QPushButton#navSidebarBack:hover {
    background: #142b43;
    color: #ffffff;
}
QPushButton#navSidebarItem:pressed, QPushButton#navSidebarCategory:pressed, QPushButton#navSidebarBack:pressed {
    background: #173a56;
}
QPushButton#navSidebarCategory {
    color: #91a8bd;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    font-size: 10px;
    font-weight: 700;
}
QPushButton#navSidebarBack {
    color: #38d4e6;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding-bottom: 12px;
}
QLabel#navSidebarSection {
    color: #4a6379;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 4px 12px 5px 12px;
    border-bottom: 1px solid rgba(41, 73, 101, 0.5);
}
QLabel#commandDeckState, QLabel#commandDeckTarget, QLabel#commandDeckClock {
    background: #0b1a2a;
    border-left: 1px solid #294965;
    color: #91a8bd;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 11px;
    min-width: 105px;
}
QLabel#commandDeckTarget { min-width: 145px; color: #c8e5f5; }
QLabel#commandDeckClock { min-width: 88px; color: #91a8bd; }

QStatusBar {
    background-color: #091827;
    border-top: 1px solid #1d4056;
    color: #91a8bd;
}

/* Dock widgets - the Photoshop-style panel system's own chrome */
QDockWidget {
    titlebar-close-icon: none;
    color: #edf7ff;
    border: 1px solid #294965;
    border-radius: 16px;
    background: #101d30;
}
QDockWidget::title {
    background-color: #101d30;
    padding: 10px 13px;
    border-bottom: 1px solid #294965;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
    font-size: 12px;
    color: #38d4e6;
}
QDockWidget::close-button, QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 2px;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background-color: #232d38;
    border-radius: 3px;
}

QTabBar::tab {
    background-color: #0b1a2a;
    color: #91a8bd;
    padding: 9px 16px;
    border: 1px solid #1d4056;
    border-bottom: none;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
}
QTabBar::tab:selected {
    background-color: #142b43;
    color: #38d4e6;
    border-bottom: 2px solid #38d4e6;
}
QTabWidget::pane {
    border: 1px solid #294965;
    border-radius: 14px;
    background-color: #101d30;
}

QGroupBox {
    border: 1px solid #294965;
    border-radius: 16px;
    margin-top: 18px;
    padding: 15px 12px 12px 12px;
    background-color: #101d30;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 7px;
    color: #38d4e6;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 1px;
}

QPushButton {
    background-color: #10243a;
    border: 1px solid #294965;
    border-radius: 10px;
    padding: 9px 15px;
    color: #edf7ff;
}
QPushButton:hover {
    background-color: #173a56;
    border-color: #38d4e6;
}
QPushButton:pressed {
    background-color: #14313a;
}
QPushButton:disabled {
    color: #4a5563;
    border-color: #1c232d;
}
QPushButton#primaryAction {
    background-color: #397dff;
    border-color: #65a1ff;
    color: #f5fbff;
    font-weight: 600;
}
QPushButton#primaryAction:hover {
    background-color: #518dff;
}
QPushButton#dangerAction {
    background-color: #3a1620;
    border-color: #7a2b3b;
    color: #ff8fa3;
}
QPushButton#dangerAction:hover {
    background-color: #4d1b28;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #081623;
    border: 1px solid #294965;
    border-radius: 10px;
    padding: 8px 10px;
    selection-background-color: #397dff;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #38d4e6;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #12161d;
    border: 1px solid #315773;
    border-radius: 10px;
    selection-background-color: #1e94a8;
    selection-color: #0b0e13;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #1c232d;
    border-radius: 2px;
}

/* Updater-equivalent card treatment for the central work surfaces.  Widgets
   that set their object name to ``deckPanel`` inherit the same 16px shell
   used by Updater's QML SectionPanel component. */
QWidget#deckPanel, QFrame#deckPanel {
    background-color: #101d30;
    border: 1px solid #294965;
    border-radius: 16px;
}
QFrame#metricCard {
    background-color: #14253b;
    border: 1px solid #316077;
    border-radius: 11px;
}
QLabel#metricAccent {
    background-color: #38d4e6;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #1e94a8;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -6px 0;
    background: #21c6de;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: #4fe0f5;
}

QDial {
    background: transparent;
}

QTableWidget, QTableView {
    background-color: #0f131a;
    alternate-background-color: #12161d;
    gridline-color: #1c232d;
    border: 1px solid #1c232d;
    selection-background-color: #1e94a8;
    selection-color: #0b0e13;
}
QHeaderView::section {
    background-color: #151b23;
    color: #7f8ea1;
    padding: 6px;
    border: none;
    border-right: 1px solid #1c232d;
    border-bottom: 1px solid #1c232d;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 1px;
}

QListWidget, QTreeWidget {
    background-color: #0f131a;
    border: 1px solid #1c232d;
    alternate-background-color: #12161d;
}
QListWidget::item, QTreeWidget::item {
    padding: 5px;
}
QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #1e94a8;
    color: #0b0e13;
}

QScrollBar:vertical {
    background: #0f131a;
    width: 10px;
}
QScrollBar::handle:vertical {
    background: #263140;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #34455a;
}
QScrollBar:horizontal {
    background: #0f131a;
    height: 10px;
}
QScrollBar::handle:horizontal {
    background: #263140;
    border-radius: 4px;
    min-width: 24px;
}

QLabel#panelHeading {
    color: #21c6de;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 11px;
}
QLabel#statusOnline {
    color: #3ddc84;
    font-weight: 600;
}
QLabel#statusOffline {
    color: #ff5c72;
    font-weight: 600;
}
QLabel#statusConnecting {
    color: #f5c542;
    font-weight: 600;
}

QSplitter::handle {
    background-color: #1c232d;
}

/* About dialog - see ui/about_dialog.py */
QDialog#aboutDialog {
    background-color: #0b1a2a;
    border: 1px solid #294965;
    border-radius: 12px;
}
QLabel#aboutTitle {
    color: #edf7ff;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
}
QLabel#aboutTagline {
    color: #c8e5f5;
    font-size: 13px;
}
QLabel#aboutDescription {
    color: #91a8bd;
    font-size: 11px;
    padding: 0 8px;
}
QWidget#aboutInfoRow {
    background-color: #07111e;
    border: 1px solid #1d4056;
    border-radius: 8px;
}
QLabel#aboutInfoLabel {
    color: #91a8bd;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
}
QLabel#aboutInfoValue {
    color: #edf7ff;
    font-size: 11px;
}
QLabel#aboutInfoValue a {
    color: #38d4e6;
}
QPushButton#aboutCloseButton {
    background-color: #38d4e6;
    color: #07111e;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 6px;
    padding: 8px 28px;
    border: 1px solid #2d9aad;
}
QPushButton#aboutCloseButton:hover {
    background-color: #55e0f0;
}
